<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Contact Pakistan Single Window Helpdesk for trade facilitation support">
    <title>PSW Helpdesk - Contact & Support</title>
</head>
<body>
    <header role="banner">
        <div class="header-container">
            <img src="/images/psw-logo.png" alt="Pakistan Single Window" class="logo">
            <nav role="navigation" aria-label="Main navigation">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/about">About PSW</a></li>
                    <li><a href="/services">Services</a></li>
                    <li><a href="/resources">Resources</a></li>
                    <li><a href="/helpdesk" aria-current="page">Help &amp; Support</a></li>
                    <li><a href="/login">Login</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main role="main">
        <section id="contact-details" aria-labelledby="contact-heading">
            <header>
                <h1 id="contact-heading">Contact Details</h1>
                <p>We're here to help with your trade facilitation needs</p>
            </header>

            <address>
                <div class="contact-item">
                    <h2>Telephone</h2>
                    <p><a href="tel:+92519261101" aria-label="Call helpdesk at +92 51 926 1101">+92 51 926 1101</a></p>
                </div>

                <div class="contact-item">
                    <h2>Email</h2>
                    <p><a href="mailto:helpdesk@psw.gov.pk" aria-label="Email helpdesk at helpdesk@psw.gov.pk">helpdesk@psw.gov.pk</a></p>
                </div>

                <div class="contact-item">
                    <h2>WhatsApp</h2>
                    <p><a href="https://wa.me/923001234567" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp">Chat with us on WhatsApp</a></p>
                </div>

                <div class="contact-item">
                    <h2>Office Hours</h2>
                    <p>Monday - Friday, 9:00 AM - 5:00 PM PKT</p>
                    <p><small>Excluding public holidays</small></p>
                </div>

                <div class="response-commitment">
                    <p><strong>Written requests answered within one working day</strong></p>
                </div>
            </address>
        </section>

        <section id="support-request" aria-labelledby="form-heading">
            <header>
                <h1 id="form-heading">Submit a Support Request</h1>
                <p>Fill out the form below and we'll get back to you</p>
            </header>

            <form id="support-form" method="POST" action="/api/support-requests" novalidate>
                <div class="form-group">
                    <label for="name">Name <span aria-label="required">*</span></label>
                    <input type="text" id="name" name="name" required aria-required="true" aria-describedby="name-error" maxlength="120">
                    <span id="name-error" class="error-message" role="alert"></span>
                </div>

                <div class="form-group">
                    <label for="email">Email Address <span aria-label="required">*</span></label>
                    <input type="email" id="email" name="email" required aria-required="true" aria-describedby="email-error">
                    <span id="email-error" class="error-message" role="alert"></span>
                </div>

                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input type="text" id="subject" name="subject" aria-describedby="subject-error" maxlength="200">
                    <span id="subject-error" class="error-message" role="alert"></span>
                </div>

                <div class="form-group">
                    <label for="message">Message <span aria-label="required">*</span></label>
                    <textarea id="message" name="message" rows="6" required aria-required="true" aria-describedby="message-error" maxlength="4000"></textarea>
                    <span id="message-error" class="error-message" role="alert"></span>
                </div>

                <button type="submit">Submit Request</button>
            </form>
        </section>
    </main>

    <footer role="contentinfo">
        <p>&copy; 2026 Pakistan Single Window. All rights reserved.</p>
    </footer>
</body>
</html>
