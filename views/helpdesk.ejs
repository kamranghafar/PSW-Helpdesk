<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Helpdesk Contact - Pakistan Single Window</title>
  <meta name="description" content="Contact PSW Helpdesk for support. Telephone, email, WhatsApp available. Submit support requests online.">
</head>
<body>
  <header>
    <div class="header-container">
      <div class="logo">
        <span class="logo-text">PSW</span>
        <span class="logo-subtitle">PAKISTAN SINGLE WINDOW</span>
      </div>
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About PSW</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/resources">Resources</a></li>
          <li><a href="/helpdesk" aria-current="page">Help &amp; Support</a></li>
          <li><a href="/login">Login</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    <section class="page-hero">
      <h1>HELP &amp; SUPPORT</h1>
      <p class="hero-subtitle">Helpdesk Contact</p>
    </section>

    <section id="contact-details">
      <h2>Contact Details</h2>
      <p class="section-intro">For any assistance or inquiries, reach out to our helpdesk team. We're available during office hours and respond to all written requests promptly.</p>
      
      <div class="contact-info">
        <div class="contact-item">
          <h3>Telephone</h3>
          <p><a href="tel:+92519223400">+92 51 922 3400</a></p>
        </div>

        <div class="contact-item">
          <h3>Email Address</h3>
          <p><a href="mailto:helpdesk@psw.gov.pk">helpdesk@psw.gov.pk</a></p>
        </div>

        <div class="contact-item">
          <h3>WhatsApp</h3>
          <p><a href="https://wa.me/923001234567">Chat with us on WhatsApp</a></p>
        </div>

        <div class="contact-item">
          <h3>Office Hours</h3>
          <p>Monday to Friday, 9:00 AM to 5:00 PM</p>
          <p class="note">(Excluding public holidays)</p>
        </div>

        <div class="contact-item">
          <h3>Response Commitment</h3>
          <p>Written requests answered within one working day</p>
        </div>
      </div>
    </section>

    <section id="support-form-section">
      <h2>Submit a Support Request</h2>
      <p class="section-intro">Fill out the form below to submit your inquiry. All fields except subject are required.</p>

      <form id="support-form" method="POST" action="/api/support-requests">
        <div class="form-group">
          <label for="name">Name</label>
          <input 
            id="name" 
            name="name" 
            type="text"
            aria-describedby="name-error" 
            required
          >
          <span id="name-error" class="error-message" hidden></span>
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input 
            id="email" 
            name="email" 
            type="email" 
            aria-describedby="email-error" 
            required
          >
          <span id="email-error" class="error-message" hidden></span>
        </div>

        <div class="form-group">
          <label for="subject">Subject <span class="optional-label">(optional)</span></label>
          <input 
            id="subject" 
            name="subject" 
            type="text"
            aria-describedby="subject-error"
          >
          <span id="subject-error" class="error-message" hidden></span>
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea 
            id="message" 
            name="message" 
            rows="6"
            aria-describedby="message-error" 
            required
          ></textarea>
          <span id="message-error" class="error-message" hidden></span>
        </div>

        <button type="submit" aria-label="Submit support request">Submit Request</button>
      </form>
    </section>
  </main>

  <footer>
    <div class="footer-container">
      <p>&copy; 2026 Pakistan Single Window. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>