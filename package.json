{
  "name": "psw-helpdesk-backend",
  "version": "1.0.0",
  "description": "PSW Helpdesk Backend Application",
  "main": "src/app.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test jest --coverage --verbose tests/helpdesk-page.test.js",
    "test:all": "cross-env NODE_ENV=test jest --coverage --verbose",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js"
  },
  "keywords": ["psw", "helpdesk", "pakistan-single-window"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
