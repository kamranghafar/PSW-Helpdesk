# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://localhost:5432/psw_helpdesk

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=5

# Security
BODY_LIMIT=10kb
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
