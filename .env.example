NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/psw_helpdesk

# Redis
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=5

# Security
BODY_LIMIT=10kb
CORS_ORIGIN=http://localhost:3000

# SMTP (for future use)
SMTP_HOST=smtp.psw.gov.pk
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
